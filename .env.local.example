# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# MongoDB connection string. Include the database name before the "?".
# Local:  mongodb://127.0.0.1:27017/school-online-test-manager
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school-online-test-manager?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session JWTs. At least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it signs everyone out, which is the intended way to revoke all sessions.
JWT_SECRET=

# Vercel Blob, for question diagrams. Created by `vercel blob store add` or in
# the Vercel dashboard; `vercel env pull .env.local` brings it down here.
# Without it the app still runs — image upload returns a clear 501 and
# questions can be written without a diagram.
BLOB_READ_WRITE_TOKEN=

# Protects the attempt-sweep endpoint. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate one with:
#   openssl rand -hex 32
# Without it the endpoint refuses every request in production, which is safe
# but means the scheduled sweep does nothing — the opportunistic sweep and the
# per-request deadline check still cover the same ground.
CRON_SECRET=

# --- Razorpay (optional until you want to charge anyone) -------------------
# Test-mode keys from dashboard.razorpay.com → Settings → API Keys.
# Without these the app runs normally, the billing page says payments aren't
# switched on, and the checkout route answers 501 rather than faking success.
# The Key ID is public — Checkout needs it in the browser. The secret is not,
# and is only ever used server-side to verify signatures.
# Full walkthrough in docs/setup.md, Part 3.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret, typed by you when creating the webhook in Razorpay's
# dashboard. Generate one with:  openssl rand -hex 32
# Razorpay signs webhook bodies with it. Without it the webhook route refuses
# every delivery, which is correct — an unsigned POST must never mark a school
# as paid.
RAZORPAY_WEBHOOK_SECRET=

# Who may open /platform, the all-schools revenue view. Comma-separated.
# Defaults to the project owner's address; set it explicitly on any deployment
# that isn't theirs.
PLATFORM_OWNER_EMAILS=
