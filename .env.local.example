# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# MongoDB connection string. Include the database name before the "?".
# Local:  mongodb://127.0.0.1:27017/shalasys
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shalasys?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign session JWTs. At least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it signs everyone out, which is the intended way to revoke all sessions.
JWT_SECRET=

# Vercel Blob, for question diagrams. Created by `vercel blob store add` or in
# the Vercel dashboard; `vercel env pull .env.local` brings it down here.
# Without it the app still runs — image upload returns a clear 501 and
# questions can be written without a diagram.
BLOB_READ_WRITE_TOKEN=

# Protects the attempt-sweep endpoint. Vercel Cron sends it as
# `Authorization: Bearer $CRON_SECRET`. Generate one with:
#   openssl rand -hex 32
# Without it the endpoint refuses every request in production, which is safe
# but means the scheduled sweep does nothing — the opportunistic sweep and the
# per-request deadline check still cover the same ground.
CRON_SECRET=

# --- Razorpay (optional until you want to charge anyone) -------------------
# Test-mode keys from dashboard.razorpay.com → Settings → API Keys.
# Without these the app runs normally, the billing page says payments aren't
# switched on, and the checkout route answers 501 rather than faking success.
# The Key ID is public — Checkout needs it in the browser. The secret is not,
# and is only ever used server-side to verify signatures.
# Full walkthrough in docs/setup.md, Part 3.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret, typed by you when creating the webhook in Razorpay's
# dashboard. Generate one with:  openssl rand -hex 32
# Razorpay signs webhook bodies with it. Without it the webhook route refuses
# every delivery, which is correct — an unsigned POST must never mark a school
# as paid.
RAZORPAY_WEBHOOK_SECRET=

# Who may open /platform, the all-schools revenue view. Comma-separated.
# Defaults to the project owner's address; set it explicitly on any deployment
# that isn't theirs.
PLATFORM_OWNER_EMAILS=

# --- Email (optional; assignments and results still work without it) -------
# Resend API key from resend.com → API Keys. Without it the app logs what it
# would have sent and carries on — a failed email must never break a test
# assignment or a result. Full walkthrough in docs/setup.md.
RESEND_API_KEY=

# Who the mail comes from. Resend accepts onboarding@resend.dev with no domain
# verification, but it only reaches your own account address — fine for a
# delivery test, not for real students. Set this once your domain is verified.
EMAIL_FROM="Shalasys <tests@yourschooldomain.com>"

# --- Error tracking (optional) --------------------------------------------
# Sentry DSN. Without one, nothing is initialised and no network calls are
# made; errors still go to the platform logs. NEXT_PUBLIC_ is required for the
# browser half — a DSN is a write-only endpoint, not a secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Public address --------------------------------------------------------
# The origin used for links in emails, canonical URLs, sitemap entries and OG
# tags. On Vercel this falls back to the project's production URL; set it
# explicitly once a custom domain is live, with no trailing slash.
APP_URL=

# --- Self-serve billing (off) ---------------------------------------------
# Plans are sold outside the app and set by a super-admin, so no school-facing
# route reaches a checkout. The Razorpay integration is kept and still tested;
# this flag is the whole of what turning it back on would take.
SELF_SERVE_BILLING=false

# Shown to a school whose plan is ending or has ended, since there is no
# longer a button for them to press. Optional — without it the copy stays
# generic rather than printing an address that bounces.
SUPPORT_EMAIL=
